{
  "name": "tech-tips-and-tricks-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Tech Tips & Tricks Hub - Turborepo monorepo containing the Next.js web app and the Express API.",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "lint:api": "pnpm --filter @tech-tips-hub/api lint",
    "lint:web": "pnpm --filter @tech-tips-hub/web lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules .turbo apps/*/.next apps/*/dist",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.11.6",
    "typescript": "^5.9.2"
  }
}
