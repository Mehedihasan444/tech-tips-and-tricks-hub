# Copy to .env.local and fill in real values. Never commit .env.local.

# Base URL of the Express API (no trailing /api/v1 - the client appends it).
NEXT_PUBLIC_SERVER_URL=http://localhost:5000
SERVER_URL=http://localhost:5000

# Auth.js v5 - required. Generate with: npx auth secret
# AUTH_SECRET is preferred; NEXTAUTH_SECRET is kept as fallback.
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials)
GOOGLE_ID=
GOOGLE_SECRET=

# Must match the server's JWT_ACCESS_SECRET so proxy.ts can decode tokens.
JWT_ACCESS_SECRET=

# One-click demo logins on the sign-in page (development only).
# Ignored when NODE_ENV=production. Defaults shown; must match the
# DEMO_* values in apps/api/.env.example so the accounts actually exist.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=true
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=admin@demo.test
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=DemoAdmin@123
NEXT_PUBLIC_DEMO_USER_EMAIL=user@demo.test
NEXT_PUBLIC_DEMO_USER_PASSWORD=DemoUser@123
