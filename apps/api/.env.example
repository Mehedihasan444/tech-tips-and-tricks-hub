# Copy to .env and fill in real values. Never commit .env.

# Runtime
NODE_ENV=development
PORT=5000

# URL of the Next.js client - used for CORS origin and email links
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000

# MongoDB connection string
DB_URL=mongodb://127.0.0.1:27017/tech-tips-and-tricks-hub

# Password hashing
BCRYPT_SALT_ROUNDS=12

# JWT - generate strong random secrets (e.g. `openssl rand -hex 32`).
# JWT_ACCESS_SECRET must be identical to the one in apps/client/.env.local
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Admin account seeded on startup (src/app/utils/seeding.ts)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PROFILE_PHOTO=
ADMIN_MOBILE_NUMBER=

# Demo accounts for the one-click role logins on the web sign-in page.
# Set DEMO_LOGIN_ENABLED=true to seed them. Forced off when NODE_ENV=production.
# Keep these values in sync with the NEXT_PUBLIC_DEMO_* values in apps/web/.env.example.
DEMO_LOGIN_ENABLED=true
DEMO_ADMIN_EMAIL=admin@demo.test
DEMO_ADMIN_PASSWORD=DemoAdmin@123
DEMO_USER_EMAIL=user@demo.test
DEMO_USER_PASSWORD=DemoUser@123

# Cloudinary image storage (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Meilisearch (search-posts endpoints)
MEILISEARCH_HOST=
MEILISEARCH_MASTER_KEY=

# Nodemailer (Gmail requires an App Password, not the account password)
SENDER_EMAIL=
SENDER_APP_PASS=

# Password-reset link, appended to CLIENT_URL
RESET_PASS_UI_LINK=/reset-password

# AamarPay payment gateway (sandbox URLs shown; swap for live when deploying)
STORE_ID=
SIGNATURE_KEY=
PAYMENT_URL=https://sandbox.aamarpay.com/transaction/checkoutendpoint.php
PAYMENT_VERIFY_URL=https://sandbox.aamarpay.com/transaction/checkendpoint.php

# Rate limiting (optional — defaults shown)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=50
